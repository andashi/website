---
import Base from "../layouts/Base.astro";
import ZoneCard from "../components/ZoneCard.astro";
import { zones } from "../data/zones";

// Als Zeichenketten, nicht als Markup: in Astro-Vorlagen wuerde { } sonst als
// Ausdruck gelesen. Beide Blöcke sind aus den Repos, nicht ausgedacht:
// provisioning/config/launcher/home.json und config/profiles.json, gekuerzt.
const launcherJson = String.raw`{
  "schemaVersion": 2,
  "appearance": {
    "glass": { "blur": 24, "tint": 0.12, "searchWallpaperBlur": true },
    "wallpaper": { "image": "home.jpg", "target": "both" }
  },
  "home": {
    "searchBar": { "position": "bottom" },
    "favorites": [
      { "packageName": "com.android.dialer" },
      { "packageName": "app.vanadium.browser" }
    ]
  },
  "search": {
    "barPosition": "top",
    "contacts": true,
    "actions": [ { "type": "call" }, { "type": "message" }, … ]
  }
}`;

// Ein Satz aus einem Lauf (Andashi Home 0.7.0, 2026-09-24), damit die sechs
// nebeneinander wie sechs Zonen aussehen und nicht wie zwei Softwareversionen.
const shots = [
  ["home", "Home", "Always on, and deliberately colourless. Phone and browser pinned above the bar."],
  ["cloud", "Cloud", "Where Google may live. Nothing pinned, so nothing but the picture."],
  ["gadgets", "Gadgets", "The gadget zone, behind its own aggressive filter."],
  ["ops", "Ops", "Management. Stopped until it is needed."],
  ["lab", "Lab", "Deliberately empty."],
  ["anon", "Anon", "Everything through Tor, and stopped when unused."],
];

const words = [
  {
    title: "GrapheneOS",
    body: "Android, hardened. A free operating system for Google Pixel phones, made by an independent non-profit project. It runs ordinary Android apps, but Google's services are not built in, and it closes holes an ordinary phone leaves open. Where an app really needs Google Play, Play can run as a normal app in a box, without special powers. andashi builds on GrapheneOS; it is not part of that project.",
  },
  {
    title: "A zone",
    body: "A separate user on the phone, as if a second person had an account on it: its own apps, its own files, its own encryption key and its own network route. An app in one zone cannot look into another. andashi sets up six, and decides for each one what may live there.",
  },
  {
    title: "Declared",
    body: "Instead of tapping through settings for an afternoon, you describe the phone in a few text files on a computer, and a script sets it up over a USB cable. Run it again and you get the same phone. Change one line and only that line changes. Afterwards the script reads the phone back and complains if the phone disagrees.",
  },
];

const files = [
  ["config/profiles.json", "What a zone is: its VPN and whether that VPN locks the zone down, whether it runs, is on demand or stays stopped, how it unlocks, which browser opens its links, whether Play services exist in it at all."],
  ["config/apps.json", "Which app lives in which zones, where its binary comes from, whether it may have the INTERNET permission, and which scopes it gets instead of full access."],
  ["config/settings.json", "Android settings per namespace — globally, for all profiles, or for one zone."],
  ["config/theming.json", "One source for the visual identity: colour per zone, wallpaper, glass, the chips under a search, favourites, and which launcher holds the HOME role."],
  ["config/features.json", "The platform features a zone uses: work profile, private space, inter-profile sharing."],
  ["config/launcher/*.json", "Generated from the above, one file per zone, pushed into the launcher and read back."],
];

const profilesJson = String.raw`{
  "key": "anon",
  "label": "Anon",
  "browser": "org.torproject.torbrowser",
  "runtime": "stopped",
  "vpn": "orbot",
  "vpn_pkg": "org.torproject.android",
  "vpn_lockdown": true,
  "vpn_note": "Mandatory: without it, traffic leaves past Tor.",
  "play": "none",
  "unlock": "password only, no fingerprint"
}`;

const adb = String.raw`# push the config into the launcher of Android user N
adb shell content write --user N \
  --uri content://org.andashi.home.config-ingest/launcher.json < launcher.json

# ask it to reload
adb shell am broadcast --user N -a org.andashi.home.action.RELOAD_CONFIG \
  -n org.andashi.home/de.mm20.launcher2.config.service.ReloadConfigReceiver

# read back what it loaded, and what it made of it
adb shell content query --user N --uri content://org.andashi.home.state/diagnostics
adb shell content query --user N --uri content://org.andashi.home.state/config`;

const mechanism = [
  {
    title: "adb, not root",
    body: "A cable and Android's own developer commands, per Android user. No root, no Magisk, no system app, no accessibility service, nothing left running on the device that could be talked into anything later.",
  },
  {
    title: "A sandbox it cannot leave",
    body: "The launcher takes its configuration through a content provider into its own files directory. It holds no system powers and needs no permissions to be configured — the config can only reach the launcher, never the platform.",
  },
  {
    title: "Read back, not reported",
    body: "Provisioning does not trust an exit code. It writes, triggers a reload, reads the effective state and the diagnostics of that reload back off the device, and fails when they disagree with the file. The same goes for Anon's browser: it checks where a plain link actually lands.",
  },
  {
    title: "Signatures someone else confirmed",
    body: "Every app is pinned to its signing certificate, and a pin is only worth as much as its witness. Most are confirmed by a second distributor, not only by whoever served the download. The ones that are not, among them the launcher, which only andashi signs, are named in the repository rather than averaged away.",
  },
];

const limits = [
  ["It has only ever run against an emulator.", "Every screenshot and video on this page comes from a GrapheneOS emulator image, which validates the chain but not the phone. What it cannot prove is written down rather than glossed over: sandboxed Play and the apps that depend on it, Play Integrity, the MAM broker and app protection policies, push notifications in daily use, fingerprint and two-factor unlock, eSIM, NFC, arm64-only apps, and how any of it feels in the hand. A real device is the next thing this project needs."],
  ["The managed work profile is a hypothesis, not a result.", "It is built for a work profile in which an employer's agent enforces policy, but whether Intune's app protection behaves inside a Shelter-managed profile is untested — it needs sandboxed Play, which the emulator target does not have. The Google Workspace alternative exists as a documented branch, never as a path anyone has run; even its package names are reasoned guesses."],
  ["It is not anonymity.", "Anon is a zone with Orbot, mandatory lockdown and Tor Browser for its links, not a cloak. Everything outside that zone is an ordinary phone with an ordinary network trail."],
  ["It needs a supported Pixel and GrapheneOS.", "Plus a computer with adb and a bootloader you are willing to unlock. There is no build for anything else, and no plan to pretend otherwise."],
  ["It builds on a wiped phone, it does not wipe one.", "Zones are Android users: provisioning creates them and can remove them again, which destroys that zone's data and nothing else. The device-wide wipe belongs to the GrapheneOS install that comes first."],
  ["Android runs three profiles at once.", "Not six. The model plans around that limit: two zones are stopped, two run on demand, and a stopped profile has its keys evicted."],
  ["Play services exist here, sandboxed.", "In Cloud and Gadgets with throwaway accounts, in the work profile with the company's, optionally in Lab, never in Home or Anon. That is a trade with a price, not a purity claim."],
  ["Not everything can be scripted.", "Whatever cannot be is generated into a MANUAL.md you work through by hand — listed, not hidden."],
];
---

<Base
  title="andashi — a phone you come home to"
  description="A GrapheneOS phone split into six zones, each with its own apps, network and colour, set up from files and checked by reading the phone back."
>
  <header class="hero">
    <div class="wrap inner">
      <div class="copy">
        <h1>A phone you come home to</h1>
        <p class="lede">
          andashi turns a Pixel running GrapheneOS into six phones in one. Each
          part, a zone, has its own apps, its own way onto the internet and its
          own colour, so the app for your 3D printer never sits next to your
          messages and your passwords. All of it is written down in files and
          set up from a computer, and the phone answers with what it actually
          applied, not with the hope that it worked.
        </p>
        <div class="actions">
          <a class="btn btn--primary" href="#zones">See the six zones</a>
          <a class="btn" href="https://github.com/andashi/provisioning">The provisioning</a>
        </div>
        <p class="warn">
          Early development, and honestly so: this has only ever run against an
          emulator, because there is no spare phone to run it against yet.
          Breaking changes are the normal case.
        </p>
      </div>

      <figure class="mark">
        <picture>
          <source srcset="/logo.webp" type="image/webp" />
          <img id="mark" src="/logo.png" alt="The andashi mark: a sliced sun over a glazed bowl"
               width="704" height="704" fetchpriority="high" />
        </picture>
      </figure>
    </div>
    <hr class="ramp" />
  </header>

  <main>
    <section id="name" class="wrap">
      <span class="kicker">The name</span>
      <h2>an + dashi</h2>
      <div class="two">
        <p class="lede">
          Dashi is the stock a Japanese kitchen starts from: kombu, katsuobushi,
          water. You never taste it on its own, it is in everything, and it is
          the reason the rest works.
        </p>
        <p class="mut">
          That is what a distribution is. It takes software other people make,
          here GrapheneOS and about forty apps, and decides how it all fits
          together: which app goes where, what is switched on, what is left out.
          When it is any good, nobody notices it — you notice the phone, not the
          files underneath. The <em>an</em> is the Android part, and the mark is
          the sun those files put on every home screen.
        </p>
      </div>
    </section>

    <section id="words" class="wrap">
      <span class="kicker">In plain words</span>
      <h2>Three words, and what they mean here</h2>
      <p class="lede">
        You do not need to know any of this to use the phone. You need it to
        judge whether the phone is for you.
      </p>
      <div class="grid three">
        {words.map((w) => (
          <div class="card">
            <h3>{w.title}</h3>
            <p class="mut">{w.body}</p>
          </div>
        ))}
      </div>
      <p class="mut after">
        A default nobody chose is still a choice: an app that comes with the
        system, a permission nobody took away, a search engine the launcher
        puts under every query. andashi makes each of those choices on purpose,
        writes it into a file, and keeps the reason next to it. The rest of
        this page is those choices.
      </p>
    </section>

    <section id="config" class="wrap">
      <span class="kicker">Configured, not clicked</span>
      <h2>The whole phone, declared</h2>
      <p class="lede">
        The zones are not set up by hand and then described — they are described
        and then set up. Six files hold the phone: what a zone is, which apps
        live in it, what they may reach, how it looks. Every deterministic
        setting is a key in one of them.
      </p>

      <dl class="files">
        {files.map(([name, what]) => (
          <div class="file">
            <dt><code>{name}</code></dt>
            <dd class="mut">{what}</dd>
          </div>
        ))}
      </dl>

      <div class="split">
        <div>
          <pre><code>{profilesJson}</code></pre>
          <p class="cap">A zone in <code>profiles.json</code>, shortened. The lockdown flag is not a preference — for Anon it is the difference between Tor and a leak. The browser line is the other half: it decides which app a link opens in.</p>
          <pre><code>{launcherJson}</code></pre>
          <p class="cap">An excerpt of Home's home screen, generated from the same sources and pushed per Android user: the glass, the wallpaper, the two favourites, where the search bar sits, and which chips a search may offer.</p>
          <pre><code>{adb}</code></pre>
          <p class="cap">How it reaches the phone. Per Android user, without root.</p>
        </div>
        <figure class="phone">
          <div class="screen"><img src="/shots/zone-home.webp" alt="The Home zone's home screen: wallpaper, Phone and Vanadium pinned, a search bar at the bottom" width="540" height="960" loading="lazy" /></div>
          <figcaption class="cap">What that file produces: the wallpaper, Phone and Vanadium pinned above the search bar, and nothing else. No grid of icons to keep tidy; the rest is one search away.</figcaption>
        </figure>
      </div>

      <p class="mut after">
        Re-running is the normal case, not the emergency: every step checks
        before it writes, and pushing an unchanged file changes nothing. A zone
        can be changed long after it was created — its apps, permissions,
        settings, VPN, theme and home screen are all re-applied in place. You
        may still move things around on the phone itself: the next run notices
        and refuses to overwrite an arrangement it has not seen.
      </p>
    </section>

    <section id="zones" class="wrap">
      <span class="kicker">The model</span>
      <h2>Six zones, one phone</h2>
      <p class="lede">
        Think of a house where the guests, the delivery people and the family
        each get their own door. The question when installing an app is never
        “do I want this app?” but “which zone is this app allowed to do damage
        in?”. Android allows exactly one VPN per profile, so the assignment is
        enforced by the phone itself rather than by discipline.
      </p>
      <div class="grid zones">
        {zones.map((zone) => <ZoneCard zone={zone} />)}
      </div>
      <p class="mut after">
        The network terms come from how careful people split a home network:
        a trusted LAN for their own devices, a DMZ for what faces the internet,
        a separate VLAN for gadgets that should not see the rest. andashi
        applies the same split to one phone.
      </p>
      <p class="mut after">
        Work is not a zone of its own: it is a managed profile inside Home, with
        its own VPN and lockdown, and its apps show badged in Home's launcher.
        It is the one place where someone else holds authority — an employer's
        agent may enforce policy there, and it sees that zone, not the phone.
      </p>
      <p class="mut after">
        Files cross a zone border one at a time and by hand: you share a photo
        or a link out of Home into another zone through Inter Profile Sharing.
        That is the only bridge, it is measured end to end, and it is honest
        about what it does — it opens a border that is otherwise closed. The
        self-hosted services stay in Home, behind a private network that does
        not exist from the outside.
      </p>
      <p class="mut after">
        Two things hold across all of them. Eleven of Home's apps have no
        internet permission at all: the cameras, the keyboard, the launcher,
        the two-factor authenticator and two AI chat apps that run on the phone
        itself do not need one, so they do not get one. An AI that cannot
        phone home is not a promise, it is a missing permission. And the
        launcher, the keyboard and the icon pack are identical in every zone —
        also without internet — so switching zones changes what you may reach,
        never how the phone works.
      </p>
    </section>

    <section id="screens">
      <div class="wrap">
        <span class="kicker">The home screen</span>
        <h2>A picture, a search bar, and nothing to tidy</h2>
        <p class="lede">
          Each zone's home screen is its own wallpaper and a search bar where
          your thumb is. The picture tells you which zone you are in before you
          touch anything; so does the colour of the quick settings, the
          icons and the keyboard. Home is the colourless one, because colour means you are
          not home.
        </p>
      </div>

      <div class="strip-wrap">
      <div class="strip" tabindex="0" role="region"
           aria-label="Home screens of the six zones, scrollable sideways">
        {shots.map(([id, label, note]) => (
          <figure class="shot">
            <div class="screen">
              <img src={`/shots/zone-${id}.webp`} alt={`The ${label} zone's home screen`}
                   width="540" height="960" loading="lazy" decoding="async" />
            </div>
            <figcaption><strong>{label}</strong><span class="cap">{note}</span></figcaption>
          </figure>
        ))}
      </div>
      </div>

      <div class="wrap">
        <div class="story">
          <div class="text">
            <h3 class="sub">Search is the app drawer</h3>
            <p class="mut">
              Tap the bar and it glides to the top of the screen. The wallpaper
              blurs behind a list you can read: your favourites, then every app
              in the zone, with a Work tab in Home. Type three letters and the
              best match sits right under the bar.
            </p>
            <p class="mut">
              The bar starts at the bottom because that is where the thumb
              reaches, and moves up because in search the keyboard owns the
              bottom. That order was chosen from screen recordings of three
              variants, not on paper.
            </p>
          </div>
          <div class="pair">
            <figure class="shot">
              <div class="screen"><video src="/video/phone-search-app.mp4" poster="/video/phone-search-app.webp" width="720" height="1280" controls muted loop playsinline preload="none" aria-label="Screen recording: tapping the search bar, typing sig, Signal appears"></video></div>
              <figcaption><strong>Recording</strong><span class="cap">Tap, the bar moves up, “sig” finds Signal.</span></figcaption>
            </figure>
            <figure class="shot">
              <div class="screen"><img src="/shots/home-search.webp" alt="Search open in the Home zone: favourites, then all apps with a Personal and a Work tab" width="720" height="1280" loading="lazy" /></div>
              <figcaption><strong>Home, search open</strong><span class="cap">Favourites, then every app; Personal and Work side by side.</span></figcaption>
            </figure>
          </div>
        </div>

        <div class="story">
          <div class="text">
            <h3 class="sub">Chips that recognise, never ones that advertise</h3>
            <p class="mut">
              Type a phone number and search offers Call, Message and Add to
              contact. An address or a time brings Email, Alarm, Timer,
              Calendar or Website. Those are the only chips there are, and they
              appear only when the query looks like one of those things.
            </p>
            <p class="mut">
              Kvaesitso, the launcher andashi's home screen is forked from, puts
              Web search, YouTube and Google under every query, in every zone.
              andashi's launcher no longer seeds YouTube and Google, and on a
              phone set up by andashi none of the three appears: provisioning
              writes the list of chips explicitly. The launcher has no internet permission in any zone, so what
              you type into it stays on the phone. Contact search exists only in
              Home, the one zone that holds contacts; the other zones do not
              nag for a permission they should not have.
            </p>
          </div>
          <div class="pair">
            <figure class="shot">
              <div class="screen"><video src="/video/phone-search-number.mp4" poster="/video/phone-search-number.webp" width="720" height="1280" controls muted loop playsinline preload="none" aria-label="Screen recording: typing a phone number, Call, Message and Add to contact appear"></video></div>
              <figcaption><strong>Recording</strong><span class="cap">A typed number becomes Call, Message, Add to contact.</span></figcaption>
            </figure>
          </div>
        </div>

        <div class="story">
          <div class="text">
            <h3 class="sub">A default is a statement</h3>
            <p class="mut">
              Anon is the zone where everything goes through Tor, the network
              that hides where you are. Until recently that was only half
              true. The traffic went through Tor, but a link tapped in a
              message opened in Vanadium, the phone's everyday browser —
              because Vanadium comes with the system, every zone gets it, and
              nobody had said otherwise. Tor hid the address; the browser gave
              websites everything else.
            </p>
            <p class="mut">
              Now Anon names its browser. Links there open in Tor Browser, the
              setup reads back where a plain link actually lands, and it refuses
              to name a browser the zone does not contain.
              Its search drops Website, Message and Contact, and it has no
              Play services and no contacts to find. Nothing here is new
              software. It is a decision that had not been made, made on
              purpose.
            </p>
          </div>
          <div class="pair">
            <figure class="shot">
              <div class="screen"><video src="/video/anon-search-tor.mp4" poster="/video/anon-search-tor.webp" width="720" height="1280" controls muted loop playsinline preload="none" aria-label="Screen recording in the Anon zone: typing tor finds Tor Browser"></video></div>
              <figcaption><strong>Anon, recording</strong><span class="cap">“tor” finds Tor Browser. No web chips underneath.</span></figcaption>
            </figure>
            <figure class="shot">
              <div class="screen"><img src="/shots/anon-search.webp" alt="Search open in the Anon zone: Molly, Orbot, Tor Browser and the system apps, no Work tab" width="720" height="1280" loading="lazy" /></div>
              <figcaption><strong>Anon, the whole zone</strong><span class="cap">Molly, Orbot, Tor Browser, and what the system brings. No Work tab.</span></figcaption>
            </figure>
          </div>
        </div>

        <div class="story">
          <div class="text">
            <h3 class="sub">The same phone, folded open</h3>
            <p class="mut">
              On a Pixel Fold the favourites move into a column on the right
              edge, where the right thumb rests, on the outer screen and on the
              inner one alike. Open the phone and the home screen follows. The
              hard cut in the recording is Android switching displays; the only
              processing restores the outer screen's proportions, which the
              recorder had stretched.
            </p>
            <p class="mut">
              On the big screen search splits into two panes that never cross
              the hinge: apps sit in the half the outer screen also shows,
              shortcuts and results in the other.
            </p>
          </div>
          <div class="pair">
            <figure class="shot wide">
              <div class="screen"><video src="/video/fold-unfold.mp4" poster="/video/fold-unfold.webp" width="720" height="820" controls muted loop playsinline preload="none" aria-label="Screen recording on a Pixel Fold: from the outer screen to the inner screen"></video></div>
              <figcaption><strong>Fold, recording</strong><span class="cap">Outer screen to inner screen, one continuous recording.</span></figcaption>
            </figure>
            <figure class="shot wide">
              <div class="screen"><img src="/shots/fold-inner-search.webp" alt="Search on the Fold's inner screen: apps in the right pane, the left pane free" width="1200" height="1244" loading="lazy" /></div>
              <figcaption><strong>Fold, search open</strong><span class="cap">Two panes, split at the hinge.</span></figcaption>
            </figure>
          </div>
        </div>

        <p class="cap narrow">
          All of this was recorded on emulators, on a laptop. Without
          recording, the launcher there draws a frame in 16 ms at the median
          while search opens and you type; the recorder itself costs frames, so
          the videos look a little less smooth than the launcher is. Those are
          numbers for comparing launcher versions with each other, not a claim
          about a real Fold. Recordings from real hardware come when the
          hardware does.
        </p>
      </div>
    </section>

    <section id="mechanism" class="wrap">
      <span class="kicker">The hard part</span>
      <h2>Configuration without a backdoor</h2>
      <p class="lede">
        Configuring Android as code usually means root, a privileged system app,
        or an accessibility service that can read the screen. Each of them is a
        master key, and all three open a hole in exactly the place GrapheneOS
        closes. So none of them is used.
      </p>
      <div class="grid three">
        {mechanism.map((m) => (
          <div class="card">
            <h3>{m.title}</h3>
            <p class="mut">{m.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="limits" class="wrap">
      <span class="kicker">Honestly</span>
      <h2>What it does not promise</h2>
      <p class="lede">
        A hardening project that only lists advantages is not credible. These are
        the limits, and they are not going to be buried in a FAQ.
      </p>
      <ul class="limits">
        {limits.map(([head, body]) => (
          <li><strong>{head}</strong> <span class="mut">{body}</span></li>
        ))}
      </ul>
    </section>

    <section id="start" class="wrap">
      <span class="kicker">What you need</span>
      <h2>Four minutes, and a phone with GrapheneOS on it</h2>
      <p class="lede">
        This is not an installer yet. Today it asks for a computer and for being
        at ease in a terminal. If that is not you, it is fine to watch for now.
      </p>
      <div class="grid three">
        <div class="card"><h3>A device</h3><p class="mut">A supported Pixel with GrapheneOS already installed and set up. That install is the step that unlocks the bootloader and clears the device.</p></div>
        <div class="card"><h3>A computer</h3><p class="mut">Anything with <code>adb</code> and <code>jq</code>. No agent runs on the phone.</p></div>
        <div class="card"><h3>About four minutes</h3><p class="mut">241 seconds for all six zones, set up and verified, measured on 24 September on the Fold emulator from a clean snapshot, with the apps coming from copies on the computer. On a real phone it will differ. Running it again is the normal case, not the emergency.</p></div>
      </div>
      <div class="actions wide">
        <a class="btn btn--primary" href="https://github.com/andashi/provisioning">andashi/provisioning</a>
        <a class="btn" href="https://github.com/andashi/home">andashi/home — the launcher</a>
      </div>
      <p class="mut after">
        No newsletter, no Discord. Watching the repositories is the way to
        follow this.
      </p>
    </section>

    <section id="faq" class="wrap">
      <span class="kicker">Reasonable objections</span>
      <h2>Why not just a shell script?</h2>
      <dl class="faq">
        <div>
          <dt>Do I have to think about zones all day?</dt>
          <dd class="mut">
            No. Most of the day you are in Home, and it is a phone. You switch to
            another zone the way Android switches users, from the quick settings,
            and the wallpaper and colours tell you where you landed. Cloud keeps
            running in the background, which is why the car key in it works
            without switching there first.
          </dd>
        </div>
        <div>
          <dt>Why not LineageOS and a few shell commands?</dt>
          <dd class="mut">
            Because a script tells you it succeeded. The interesting part here is
            not writing settings, it is reading them back and failing loudly when
            the device disagrees with the file — and doing that per profile, six
            times, without root. The GrapheneOS base is the other half: verified
            boot and a hardened runtime are not something a script adds later.
          </dd>
        </div>
        <div>
          <dt>Why not Magisk modules, or a configuration app?</dt>
          <dd class="mut">
            Both need the permissions that make the hardening pointless. Root and
            an accessibility service are exactly the holes this is built to avoid,
            so configuration goes through adb from outside and nothing privileged
            stays behind on the phone.
          </dd>
        </div>
        <div>
          <dt>Can I run it on a phone that is not a Pixel?</dt>
          <dd class="mut">
            No. GrapheneOS supports Pixels, and everything here assumes it. The
            zone model would port to plain Android, but without verified boot and
            the hardened runtime it would be a different, weaker thing.
          </dd>
        </div>
        <div>
          <dt>Six profiles sounds like a lot of switching.</dt>
          <dd class="mut">
            It is. Two of them are stopped most of the time and two run on demand,
            because Android only runs three at once. If you want one phone for
            everything with no seams, this is the wrong project.
          </dd>
        </div>
      </dl>
    </section>
  </main>

